# =============================================================================
# Accenor Consulting — environment variables
# Copy to `.env.local` (local) or set in Vercel / Render. Never commit secrets.
# =============================================================================

# Public site origin (metadata, absolute links)
NEXT_PUBLIC_SITE_URL=https://accenorconsulting.com

# MongoDB (Supabase Atlas, MongoDB Atlas, etc.)
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/accenor?retryWrites=true&w=majority

# Resend — free tier transactional email (https://resend.com)
# Verify a domain for production deliverability; onboarding@resend.dev is for tests only.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_FROM_EMAIL=enquiries@your-verified-domain.com
CONTACT_FROM_NAME=Accenor Consulting
CONTACT_TO_EMAIL=accenorconsulting@gmail.com

# Visitor auto-reply doubles email usage on free tiers (true/false)
SEND_INQUIRY_AUTO_REPLY=true

# Mongo-backed rate limits (no Redis) — per IP / per email window
INQUIRY_RATE_LIMIT_MAX=5
INQUIRY_RATE_LIMIT_WINDOW_MS=900000
INQUIRY_EMAIL_RATE_LIMIT_MAX=3
